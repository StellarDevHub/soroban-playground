# Backend environment variables for soroban-playground
# Copy this to .env and customize per environment

# App
PORT=5000
APP_ENV=development

# Dual-protocol Soroban gateway
GRPC_ENABLED=true
GRPC_HOST=127.0.0.1
GRPC_PORT=50051
GRPC_TLS=false
GRPC_GATEWAY_HOST=127.0.0.1
GRPC_GATEWAY_DEADLINE_MS=120000
# Optional access token for backend-to-backend gRPC clients.
# GRPC_AUTH_TOKEN=
# For TLS, use SSL_KEY_PATH / SSL_CERT_PATH; set the following if using a
# private CA or a certificate name different from localhost.
# GRPC_ROOT_CERT_PATH=
# GRPC_TLS_SERVER_NAME=

# CORS
# Comma-separated trusted origins; single-label wildcards are supported
# (https://*.example.com). Origins can also be added at runtime through the
# admin-only /api/cors-whitelist API.
#
# Development/test: blank or "*" allows every origin; once set, localhost on
#   any port stays trusted unless CORS_ALLOW_LOCALHOST=false.
# Production (NODE_ENV or APP_ENV=production): blank or "*" is IGNORED and
#   cross-origin browser requests are rejected, so set this (or FRONTEND_URL).
#   CORS_ALLOW_ALL_ORIGINS=true is an explicit, logged opt-out.
CORS_ALLOWED_ORIGINS=
FRONTEND_URL=
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOW_LOCALHOST=true
# Reject (403) requests whose Origin header is not trusted, so cross-origin
# "simple" requests cannot trigger side effects.
CORS_STRICT_ORIGIN_CHECK=true
CORS_WHITELIST_REFRESH_MS=60000
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOWED_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
CORS_ALLOWED_HEADERS=
CORS_EXPOSED_HEADERS=
CORS_MAX_AGE_SECONDS=86400

# Rate limiting (milliseconds and counts). Buckets are Redis-backed token
# buckets: MAX is the burst size, refilled continuously over WINDOW_MS.
# compile/deploy/invoke limits are multiplied by the caller's verified API key
# tier (free 1x, standard 5x, premium 20x, admin 100x).
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=1000
COMPILE_RATE_LIMIT_WINDOW_MS=60000
COMPILE_RATE_LIMIT_MAX=10
DEPLOY_RATE_LIMIT_WINDOW_MS=60000
DEPLOY_RATE_LIMIT_MAX=15
INVOKE_RATE_LIMIT_WINDOW_MS=60000
INVOKE_RATE_LIMIT_MAX=30

# Client IP resolution. X-Forwarded-For / CF-Connecting-IP / X-Real-IP are
# only honoured when the TCP peer matches TRUSTED_PROXIES (comma-separated
# CIDRs or proxy-addr keywords: loopback, linklocal, uniquelocal).
TRUST_PROXY=true
TRUSTED_PROXIES=loopback,linklocal,uniquelocal
# Optional cap on how many trusted hops may be skipped in X-Forwarded-For.
TRUST_PROXY_HOPS=

# Compile settings
COMPILE_COMMAND=cargo build --target wasm32-unknown-unknown --release
COMPILE_TIMEOUT_MS=30000
COMPILE_TEMP_DIR_PREFIX=.tmp_compile_
WASM_TARGET_SUBPATH=target/wasm32-unknown-unknown/release
WASM_FILENAME=soroban_contract.wasm
SOROBAN_SDK_VERSION=20.0.0

# Sandboxed compilation engine (issue #1330)
# COMPILE_SANDBOX_MODE: auto | docker | process
#   auto    - use Docker when available, otherwise fall back to the process
#             sandbox (strict timeout + process-group kill, best-effort ulimits)
#   docker  - compile inside an ephemeral rootless container with hard caps
#   process - always use the local-process fallback (no container isolation)
COMPILE_SANDBOX_MODE=auto
# Image built from backend/docker/compile.Dockerfile (rust + wasm32 target).
COMPILE_SANDBOX_IMAGE=soroban-compile:latest
# Hard resource caps applied to the sandbox.
COMPILE_SANDBOX_MEMORY_MB=512
COMPILE_SANDBOX_CPU_CORES=2
COMPILE_SANDBOX_PIDS_LIMIT=256
# uid:gid the container runs as (must exist inside the sandbox image).
COMPILE_SANDBOX_USER=1000:1000
# Where ephemeral compile workspaces live (defaults to the OS temp dir).
# TMP_BUILD_DIR=

# Contract source verification
VERIFICATION_MAX_SOURCE_BYTES=1048576
VERIFICATION_MAX_WASM_BYTES=20971520
VERIFICATION_ARTIFACT_ROOT=
# Optional per-network RPC override, e.g. TESTNET_RPC_URL=https://soroban-testnet.stellar.org
TESTNET_RPC_URL=

# Network defaults
DEFAULT_NETWORK=testnet

# Simulation delays for stubbed routes (milliseconds)
DEPLOY_SIMULATED_DELAY_MS=1500
INVOKE_SIMULATED_DELAY_MS=1000

# Database Configuration
DB_TYPE=sqlite
DATABASE_URL=sqlite://indexer.db
SECONDARY_DATABASE_URL=postgresql://user:pass@localhost:5432/indexer

# Redis Configuration
# Unified Redis connection with exponential backoff and circuit breaker
REDIS_URL=redis://localhost:6379
# Enable TLS for Redis connections (set to true for AWS ElastiCache, Azure Cache, etc.)
REDIS_TLS=false
# Reject unauthorized TLS certificates (set to false for self-signed certs in dev)
REDIS_TLS_REJECT_UNAUTHORIZED=true
# Redis Cluster nodes (comma-separated, e.g., "node1.redis:6379,node2.redis:6379")
# Leave empty for standalone Redis. Enables cluster mode when set.
REDIS_CLUSTER_NODES=

# Kafka / Redpanda ledger event ingestion (#1752)
# Set KAFKA_ENABLED=true to start the consumer with the backend.
KAFKA_ENABLED=false
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_CLIENT_ID=soroban-playground-ledger-ingest
KAFKA_GROUP_ID=soroban-playground-ledger-indexer
KAFKA_TOPICS=soroban-ledger-events
KAFKA_FROM_BEGINNING=false
KAFKA_SESSION_TIMEOUT_MS=30000
KAFKA_HEARTBEAT_INTERVAL_MS=3000
KAFKA_MAX_BYTES_PER_PARTITION=1048576
KAFKA_MAX_WAIT_MS=100
KAFKA_PARTITIONS_CONCURRENTLY=3
KAFKA_RECONNECT_BASE_MS=500
KAFKA_RECONNECT_MAX_MS=30000
KAFKA_LAG_CHECK_INTERVAL_MS=15000

# File Notary Contract
NOTARY_CONTRACT_ID=your-contract-id-here
STELLAR_NETWORK=testnet

# Transaction Fee Escalation Engine (#745)
FEE_ENGINE_MAX_FEE=10000
FEE_ENGINE_ESCALATION_FACTOR=1.5
FEE_ENGINE_MAX_ATTEMPTS=5

# Automated secret rotation (issue #738) — all optional, off by default.
# AES key for the in-memory credential store (random per-process if unset).
CREDENTIAL_ENCRYPTION_KEY=
# Optional JSON file holding rotatable credentials (e.g. { "REDIS_URL": "..." }).
CREDENTIAL_SOURCE_FILE=
# Periodic source-file poll interval in ms; 0 disables the periodic check.
CREDENTIAL_ROTATION_INTERVAL_MS=0
# Grace period (ms) before the old DB handle is closed after a rotation.
CREDENTIAL_ROTATION_GRACE_MS=5000
# Shared secret for the POST /api/credentials/rotate webhook; unset disables it.
CREDENTIAL_ROTATION_WEBHOOK_SECRET=

# ─── Automated SQLite Backups ─────────────────────────────────────────────────
# Set BACKUP_ENABLED=true to activate the scheduled backup cron job.
BACKUP_ENABLED=false

# Cron expression for the backup schedule (default: daily at 02:00).
BACKUP_CRON_SCHEDULE=0 2 * * *

# AWS S3 destination bucket (required when BACKUP_ENABLED=true).
BACKUP_S3_BUCKET=

# S3 object key prefix — all backup objects are stored under this path.
BACKUP_S3_PREFIX=sqlite-backups/

# AWS region of the S3 bucket.
BACKUP_S3_REGION=us-east-1

# AES-256 encryption key as a 64-character hex string (32 bytes, required).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKUP_ENCRYPTION_KEY=

# Number of daily backups to retain in S3 before pruning older ones (default: 30).
BACKUP_RETENTION_COUNT=30

# Temporary directory for SQLite snapshots during the backup pipeline.
# Defaults to the OS temp dir. Must have sufficient free space for one DB copy.
BACKUP_TEMP_DIR=
