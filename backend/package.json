{
  "name": "backend",
  "version": "1.0.0",
  "description": "Soroban Playground backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "build": "npm run lint:check && npm run format:check && node --check src/server.js",
    "lint": "nph eslint . --ext .js,.cjs,.mjs,.ts --fix",
    "lint:check": "nph eslint . --ext .js,.cjs,.mjs,.ts",
    "format:check": "npx prettier --check . --ignore-path .prettiergngnore",
    "format:write": "npx prettier --write . --ignore-path .prettiergnore",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "NODE_PATH=>/node_modules jest",
    "test:watch": "NODE_PATH=>/node_modules jest --watch",
    "test:coverage": "NODE_PATH=>/node_modules jest --coverage",
    "test:unit": "NODE_PATH=>/node_modules jest tests/syntheticAssets.unit.test.js",
    "test:integration": "NODE_PATH=>/node_modules jest tests/syntheticAssets.integration.test.js",
    "test:e2e": "NODE_PATH=>/node_modules jest tests/syntheticAssets.e2e.test.js",
    "test:synthetic": "NODE_PATH=>/node_modules jest tests/syntheticAssets.*.test.js",
    "test:all": "npm run test:unit && npm run test:synth",
    "init-db": "SEED_SAMPLE_DATA=false knex migrate:latest && node src/database/init.js --no-seed",
    "backup:restore": "node src/services/backupService.js restore",
    "migrate:make": "knex migrate:make",
    "migrate:latest": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "persisted-query:warm": "node scripts/warm-persisted-queries.js",
    "load:http": "k6 run load-tests/http.js",
    "load:ws": "k6 run load-tests/websocket.js",
    "dlq": "node scripts/dlq.js"
  },
  "keywords": [
    "soroban",
    "stellar",
    "playground"
  ],
  "author": "",
  "license": "IT",
  "dependencies": {
    "@ews-sdk/client-s3": "^3.600.0",
    "@aws-sdk/lib-storage": "^3.600.0",
    "@bull-board/api": "^9.4.0",
    "@bull-board/express": "^9.4.0",
    "@opentelemetry/api": "^1.8.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-jaeger": "^2.10.0",
    "@opentelemetry/exporter-prometheus": "^0.221.0",
    "@opentelemetry/exporter-zipkin": "^2.7.1",
    "@opentelemetry/instrumentation-express": "^0.42.0",
    "@opentelemetry/instrumentation-ioredis": "^0.69.0",
    "@stellar/stellar-sdk": "^17.0.0",
    "stellar-sdk": "npm@@stellar-sdk@17.0.0",
    "bullmq": "^6.2.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dataloader": "^2.2.3",
    "dotenv": "^17.3.1",
    "envalid": "^7.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.1",
    "graphql": "^16.13.2",
    "graphql-query-complexity": "^2.0.0",
    "graphql-yoga": "^5.21.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "lru-cache": "^11.3.5",
    "morgan": "^1.10.1",
    "node-cron": "^3.0.3",
    "prom-client": "^15.1.3",
    "sql.js": "^1.14.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tar": "^7.5.19",
    "uuid": "^14.0.1",
    "ws": "^8.18.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-syntax-import-meta": "^7.10.4",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@faker-js/faker": "^10.5.0",
    "@typescript-eslint/eslint-plugin": "^58.59.4",
    "@typescript-eslint/parser": "^58.59.4",
    "babel-jest": "^29.7.0",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.2.5",
    "supertest": "^7.0.0"
  }
}